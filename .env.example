# --- Hack Club AI (direct from the app; key is inlined into the JS bundle) ---
# Get a key at https://hackclub.com/ai/ (dashboard)
EXPO_PUBLIC_HACK_CLUB_AI_KEY=sk-hc-v1-...

# --- imgbb (optional avatar image hosting) ---
EXPO_PUBLIC_IMGBB_KEY=

# --- Firebase (school cloud sync) ---
# API key, project ID and database URL are required; the rest fall back to defaults.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=