---
import OptimizedImage from "../../layouts/utilities/OptimizedImage.astro";

const sections = [
  {
    title: "Product",
    links: [
      { name: "Features", href: "/#features" },
      { name: "For every role", href: "/#roles" },
      { name: "How it works", href: "/#how-it-works" },
      { name: "FAQ", href: "/faq" },
    ],
  },
  {
    title: "Legal",
    links: [
      { name: "Terms of service", href: "/terms" },
      { name: "Privacy policy", href: "/privacy" },
    ],
  },
  {
    title: "Roles",
    links: [
      { name: "Students", href: "/#roles" },
      { name: "Teachers", href: "/#roles" },
      { name: "Parents", href: "/#roles" },
      { name: "Admins", href: "/#roles" },
    ],
  },
];
---

<footer
  class="bg-gradient-to-br from-accent-50 via-white to-accent-100 border-base-200 mt-20">
  <div class="px-6 md:px-12 lg:px-24 py-20 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-16">
      <div class="md:col-span-1">
        <a href="/" class="inline-flex items-center gap-3">
          <OptimizedImage width={40} src="/logo.png" alt="ARC logo" />
          <span class="text-lg font-semibold text-black">ARC</span>
        </a>
        <p class="mt-4 text-sm text-gray-500">
          ARC (Academic Risk &amp; Change) — the school academic-management
          and early-intervention platform for students, teachers, parents and
          admins. One app. Four roles. Every student accounted for.
        </p>
      </div>

      <div class="md:col-span-2">
        <h3 class="text-lg font-semibold text-black mb-2">
          Ready to see your school in ARC?
        </h3>
        <p class="text-sm text-gray-500 mb-4">
          Try a one-tap demo account for every role, or register your school —
          no setup call required.
        </p>
        <div class="flex flex-col sm:flex-row items-center gap-3 w-full">
          <a
            href="https://github.com/Sai-Santosh-Pal/academic-analyzer/releases/download/v1/arc.apk"
            class="px-6 py-2 w-full md:w-auto rounded-md text-center bg-accent-600 text-white hover:bg-accent-700 transition">
            Download the app (Android APK)
          </a>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-8 text-sm text-gray-600">
      {
        sections.map(({ title, links }) => (
          <div>
            <h4 class="text-base font-semibold text-black mb-5">{title}</h4>
            <ul>
              {links.map(({ name, href }) => (
                <li class="first:prose-a:pt-0 last:prose-a:pb-0">
                  <a
                    href={href}
                    class="hover:text-accent-600 py-2 inline-block transition">
                    {name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="pt-12 mt-12 border-t border-base-200 flex flex-col md:flex-row justify-between items-center text-xs text-gray-400">
      <p>&copy; {new Date().getFullYear()} ARC. One app. Four roles. Every student accounted for.</p>
      <p>Built with Expo, TypeScript &amp; Astro</p>
    </div>
  </div>
</footer>