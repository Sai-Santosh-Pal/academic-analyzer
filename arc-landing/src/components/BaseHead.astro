---
import "../styles/global.css";
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Basic Meta Tags -->
<title>ARC — School Academic Management & Early-Intervention Platform</title>
<meta
  name="description"
  content="ARC (Academic Risk & Change) is a multi-role school platform for students, teachers, parents and admins. Track marks, attendance, assignments and interventions school-wide, flag at-risk students early, and turn school data into plain-language AI summaries."
/>
<meta
  name="keywords"
  content="school management, student tracker, academic dashboard, early intervention, attendance, marks, timetable, report cards, AI insights, teacher, parent, admin"
/>
<meta name="author" content="ARC" />

<!-- Favicons -->
<link rel="icon" href="/logo.png" sizes="any" />

<!-- Favicon for IE -->
<link rel="shortcut icon" href="/logo.png" type="image/x-icon" />

<!-- Open Graph / Facebook -->
<meta property="og:image" content="/og-image.png" />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://yoursite.com/" />
<meta property="og:title" content="ARC — One app. Four roles. Every student accounted for." />
<meta
  property="og:description"
  content="School-wide academic management and early intervention for students, teachers, parents and admins. Offline-first, AI-assisted, and grounded in real data."
/>

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="https://yoursite.com/" />
<meta property="twitter:title" content="ARC — One app. Four roles. Every student accounted for." />
<meta
  property="twitter:description"
  content="School-wide academic management and early intervention for students, teachers, parents and admins."
/>
<meta property="twitter:image" content="/og-image.png" />

<!-- Canonical URL -->
<link rel="canonical" href="https://yoursite.com/" />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />

<!-- Apple Touch Icon -->
<link rel="apple-touch-icon" sizes="180x180" href="/logo.png" />

<!-- Theme Color for Mobile Browsers -->
<meta name="theme-color" content="#0A84FF" />

<!---- Alpine  -->
<script is:inline defer src="https://unpkg.com/alpinejs@3.10.5/dist/cdn.min.js">
</script>